{$SITE_DOMAIN} {
	handle /api/* {
		reverse_proxy behbar-api:8787
	}
	# sitemap.xml route
	handle /sitemap.xml {
		reverse_proxy behbar-api:8787
	}
	# Exact match for /management without trailing slash
	handle /management {
		rewrite * /
		reverse_proxy behbar-admin:80
	}
	# Strip /management prefix and proxy to admin container
	handle_path /management/* {
		reverse_proxy behbar-admin:80
	}
	# All other requests proxy to customer site
	handle {
		reverse_proxy behbar-site:80
	}
}
