{$SITE_DOMAIN} {
	handle /api/* {
		reverse_proxy behbar-api:8787
	}
	# sitemap.xml باید روی دامنه‌ی خود سایت (نه /api) در دسترس باشد — behbar-api همین مسیر را هم جواب می‌دهد.
	handle /sitemap.xml {
		reverse_proxy behbar-api:8787
	}
	# Caddy مسیر /management (بدون / انتهایی) را با /management/* یکی نمی‌داند — کاربری که دقیقاً همان
	# آدرسی که README می‌گوید را باز کند (بدون /) بدون این هندلر به behbar-site (سایت مشتریان) می‌افتد و
	# 404 خام nginx می‌گیرد، نه پنل مدیریت. عمداً داخل یک handle جدا (نه یک redir سطح‌بالا کنار
	# handle/handle_path‌های دیگر) چون این‌جا سایر مسیرها هم با همین الگو نوشته شده‌اند و ترتیب اجرای
	# چند handle متوالی، برخلاف دایرکتیوهای معمولی، دقیقاً همان ترتیب نوشته‌شده در فایل است — قابل‌اعتمادتر
	# از تکیه به ترتیب خودکار caddy برای مخلوط‌کردن یک redir ساده با بلوک‌های handle.
	handle /management {
		redir * /management/ 308
	}
	# handle_path پیشوند /management را قبل از فوروارد حذف می‌کند — behbar-admin دقیقاً همان‌طور که
	# روی مسیر خودش سرو می‌کند، بدون آگاهی از این پیشوند، درخواست را جواب می‌دهد.
	handle_path /management/* {
		reverse_proxy behbar-admin:80
	}
	handle {
		reverse_proxy behbar-site:80
	}
}
