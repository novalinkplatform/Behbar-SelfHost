FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY dist-node ./dist-node
COPY schema.sql ./schema.sql
COPY bootstrap-selfhost-seed.sql ./bootstrap-selfhost-seed.sql
COPY --from=docker:26-cli /usr/local/bin/docker /usr/local/bin/docker
EXPOSE 8787
VOLUME ["/data"]
CMD ["node", "dist-node/selfhost/self-host-server.js"]
