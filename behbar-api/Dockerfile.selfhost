FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:selfhost

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist-node ./dist-node
COPY --from=build /app/schema.sql ./schema.sql
COPY --from=build /app/bootstrap-selfhost-seed.sql ./bootstrap-selfhost-seed.sql
# فقط باینری داکر (نه دیمن) — برای این‌که بتواند «docker run» یک کانتینر کمکی جدا بزند که خودِ
# به‌روزرسانی (pull/up -d) را از بیرونِ چرخه‌ی عمر همین کانتینر انجام دهد (پنل به‌روزرسانی یک‌کلیکی).
COPY --from=docker:26-cli /usr/local/bin/docker /usr/local/bin/docker

EXPOSE 8787
VOLUME ["/data"]
CMD ["node", "dist-node/selfhost/self-host-server.js"]
