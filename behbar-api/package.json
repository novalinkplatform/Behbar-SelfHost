{
  "name": "behbar-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute behbar-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute behbar-db --remote --file=./schema.sql",
    "build:selfhost": "tsc -p tsconfig.selfhost.json",
    "start:selfhost": "node dist-node/selfhost/self-host-server.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
